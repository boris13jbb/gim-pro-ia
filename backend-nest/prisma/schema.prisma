  nombre_sistema        String?                       @db.VarChar(100)
  ruc                   String?                       @db.VarChar(20)
  razon_social          String?                       @db.VarChar(255)
  nombre_comercial      String?                       @db.VarChar(255)
  direccion             String?                       @db.VarChar(255)
  ubigeo                String?                       @default("150101") @db.VarChar(6)
  departamento          String?                       @default("LIMA") @db.VarChar(60)
  provincia             String?                       @default("LIMA") @db.VarChar(60)
  distrito              String?                       @default("LIMA") @db.VarChar(60)
  urbanizacion          String?                       @db.VarChar(120)
  codigo_pais           String?                       @default("PE") @db.VarChar(2)
  telefono              String?                       @db.VarChar(20)
  email                 String?                       @db.VarChar(100)
  logo                  String?                       @db.VarChar(255)
  moneda                String?                       @default("$") @db.VarChar(10)
  sunat_ambiente        configuracion_sunat_ambiente? @default(beta)
  sunat_usuario_sol     String?                       @db.VarChar(50)
  sunat_clave_sol       String?                       @db.VarChar(255)
  sunat_certificado     String?                       @db.VarChar(255)
  sunat_cert_clave      String?                       @db.VarChar(255)
  igv_tasa              Decimal?                      @default(18.00) @db.Decimal(5, 2)
  incluye_igv           Boolean?                      @default(true)
  sri_ambiente          configuracion_sri_ambiente?   @default(dbgenerated("1"))
