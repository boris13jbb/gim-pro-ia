model detalle_ventas {
  id              Int       @id @default(autoincrement())
  tenant_id       Int       @default(dbgenerated())
  venta_id        Int
  producto_id     Int
  cantidad        Int
  precio_unitario Decimal   @db.Decimal(10, 2)
  subtotal        Decimal   @db.Decimal(10, 2)
  tenants         tenants   @relation(fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_detalle_ventas_tenant")
  ventas          ventas    @relation(fields: [venta_id, tenant_id], references: [id, tenant_id], onDelete: Cascade, onUpdate: Restrict, map: "detalle_ventas_ibfk_1")
  productos       productos @relation(fields: [producto_id, tenant_id], references: [id, tenant_id], onUpdate: Restrict, map: "detalle_ventas_ibfk_2")

  @@index([producto_id, tenant_id], map: "producto_id")
  @@index([venta_id, tenant_id], map: "venta_id")
  @@index([tenant_id], map: "idx_detalle_ventas_tenant")
}

model gastos {
  id               Int            @id @default(autoincrement())
  tenant_id        Int            @default(dbgenerated())
  descripcion      String         @db.VarChar(255)
  monto            Decimal        @db.Decimal(10, 2)
  fecha            DateTime       @db.Date
  estado           gastos_estado? @default(creado)
  motivo_anulacion String?        @db.VarChar(255)
  tenants          tenants        @relation(fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_gastos_tenant")

  @@index([tenant_id, fecha], map: "idx_gastos_tenant_fecha")
}

model medidas {
  id        Int       @id @default(autoincrement())
  tenant_id Int       @default(dbgenerated())
  socio_id  Int
  peso      Decimal?  @db.Decimal(5, 2)
  grasa     Decimal?  @db.Decimal(5, 2)
  cintura   Decimal?  @db.Decimal(5, 2)
  brazo     Decimal?  @db.Decimal(5, 2)
  fecha     DateTime? @db.Date
  tenants   tenants   @relation(fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_medidas_tenant")
  socios    socios    @relation(fields: [socio_id, tenant_id], references: [id, tenant_id], onDelete: Cascade, onUpdate: Restrict, map: "medidas_ibfk_1")

  @@index([socio_id, tenant_id], map: "socio_id")
  @@index([tenant_id], map: "idx_medidas_tenant")
}

model planes {
  id            Int             @id @default(autoincrement())
  tenant_id     Int             @default(dbgenerated())
  nombre        String          @db.VarChar(50)
  precio        Decimal         @db.Decimal(10, 2)
  duracion_dias Int
  descripcion   String?         @db.Text
  estado        planes_estado?  @default(activo)
  tenants       tenants         @relation(fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_planes_tenant")
  suscripciones suscripciones[]

  @@index([tenant_id], map: "idx_planes_tenant")
}

model productos {
  id                     Int                      @id @default(autoincrement())
  tenant_id              Int                      @default(dbgenerated())
  categoria_id           Int
  codigo                 String?                  @db.VarChar(50)
  nombre                 String                   @db.VarChar(150)
  precio_compra          Decimal                  @db.Decimal(10, 2)
  precio_venta           Decimal                  @db.Decimal(10, 2)
  stock                  Int?                     @default(0)
  foto                   String?                  @db.VarChar(255)
  estado                 productos_estado?        @default(activo)
  detalle_ventas         detalle_ventas[]
  tenants                tenants                  @relation(fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_productos_tenant")
  categorias             categorias               @relation(fields: [categoria_id, tenant_id], references: [id, tenant_id], onUpdate: Restrict, map: "productos_ibfk_1")
  movimientos_inventario movimientos_inventario[]

  @@unique([id, tenant_id], map: "uq_productos_id_tenant")
  @@index([categoria_id, tenant_id], map: "categoria_id")
  @@index([tenant_id], map: "idx_productos_tenant")
}

/// Auditoría de entradas/salidas de stock (NestJS Fase 06 ampliada)
model movimientos_inventario {
  id             Int                         @id @default(autoincrement())
  tenant_id      Int                         @default(dbgenerated())
  producto_id    Int
  tipo           movimientos_inventario_tipo
  cantidad       Int
  stock_anterior Int
  stock_nuevo    Int
  /// Relación opcional: la coherencia de tenant con `ventas` la valida el trigger (Prisma no admite FK compuesta opcional).
  venta_id       Int?
  usuario_id     Int?
  notas          String?                     @db.VarChar(255)
  created_at     DateTime                    @default(now()) @db.DateTime(0)
  tenants        tenants                     @relation(fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_movimientos_inventario_tenant")
  productos      productos                   @relation(fields: [producto_id, tenant_id], references: [id, tenant_id], onUpdate: Restrict, map: "movimientos_inventario_ibfk_1")
  ventas         ventas?                     @relation(fields: [venta_id], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "movimientos_inventario_ibfk_2")
  usuarios       usuarios?                   @relation(fields: [usuario_id], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "movimientos_inventario_ibfk_3")

  @@index([producto_id, tenant_id], map: "idx_mov_inv_producto")
  @@index([venta_id], map: "idx_mov_inv_venta")
  @@index([usuario_id], map: "idx_mov_inv_usuario")
  @@index([created_at], map: "idx_mov_inv_created")
  @@index([tenant_id, created_at], map: "idx_mov_inv_tenant_created")
}

model rutinas {
  id               Int       @id @default(autoincrement())
  tenant_id        Int       @default(dbgenerated())
  socio_id         Int
  dia1             String?   @db.Text
  dia2             String?   @db.Text
  dia3             String?   @db.Text
  dia4             String?   @db.Text
  dia5             String?   @db.Text
  dia6             String?   @db.Text
  observaciones    String?   @db.Text
  fecha_asignacion DateTime? @default(now()) @db.DateTime(0)
  tenants          tenants   @relation(fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_rutinas_tenant")
  socios           socios    @relation(fields: [socio_id, tenant_id], references: [id, tenant_id], onDelete: Cascade, onUpdate: Restrict, map: "rutinas_ibfk_1")

  @@index([socio_id, tenant_id], map: "socio_id")
  @@index([tenant_id], map: "idx_rutinas_tenant")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// Socio de UN gimnasio: la misma persona en dos gimnasios son dos filas independientes.
model socios {
  id               Int                   @id @default(autoincrement())
  tenant_id        Int                   @default(dbgenerated())
  nombre           String                @db.VarChar(100)
  dni              String                @db.VarChar(20)
  tipo_doc         String?               @default("1") @db.VarChar(1)
  direccion_fiscal String?               @db.VarChar(255)
  email            String?               @db.VarChar(100)
  telefono         String?               @db.VarChar(20)
  whatsapp_api_key String?               @db.VarChar(50)
  fecha_registro   DateTime?             @default(now()) @db.DateTime(0)
  estado           socios_estado?        @default(activo)
  foto             String?               @db.VarChar(255)
  password         String?               @db.VarChar(255)
  tenants          tenants               @relation(fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_socios_tenant")
  asistencias      asistencias[]
  medidas          medidas[]
  rutinas          rutinas[]
  suscripciones    suscripciones[]
  ventas           ventas[]
  refreshTokens    auth_refresh_tokens[]
  ai_conversations ai_conversations[]
  notifications    notifications[]

  // El DNI identifica al socio dentro de su gimnasio, no en toda la plataforma.
  @@unique([tenant_id, dni], map: "uq_socios_tenant_dni")
  @@unique([id, tenant_id], map: "uq_socios_id_tenant")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model sri_log {
  id             Int       @id @default(autoincrement())
  tenant_id      Int       @default(dbgenerated())
  /// Sin FK (legacy). El trigger hereda/valida el tenant del comprobante cuando existe.
  comprobante_id Int?
  accion         String    @db.VarChar(40)
  request_xml    String?   @db.MediumText
  response_xml   String?   @db.MediumText
  codigo         String?   @db.VarChar(10)
  mensaje        String?   @db.Text
  creado_en      DateTime? @default(now()) @db.DateTime(0)
  tenants        tenants   @relation(fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sri_log_tenant")

  @@index([accion], map: "idx_accion")
  @@index([comprobante_id], map: "idx_comp_log")
  @@index([tenant_id], map: "idx_sri_log_tenant")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model sri_series {
  id          Int                @id @default(autoincrement())
  tenant_id   Int                @default(dbgenerated())
  tipo_doc    String             @db.VarChar(2)
  serie       String             @db.VarChar(6)
  correlativo Int                @default(0)
  descripcion String?            @db.VarChar(120)
  estado      sri_series_estado? @default(activo)
  tenants     tenants            @relation(fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sri_series_tenant")

  @@unique([tenant_id, tipo_doc, serie], map: "unq_tipo_serie")
}

model suscripciones {
  id               Int                             @id @default(autoincrement())
  tenant_id        Int                             @default(dbgenerated())
  /// Relaciones opcionales: la coherencia de tenant con socio/plan la valida el trigger.
  socio_id         Int?
  plan_id          Int?
  fecha_inicio     DateTime?                       @db.Date
  fecha_fin        DateTime?                       @db.Date
  estado           suscripciones_estado?           @default(activa)
  tipo_comprobante suscripciones_tipo_comprobante? @default(boleta)
  comprobante_id   Int?
  tenants          tenants                         @relation(fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_suscripciones_tenant")
  socios           socios?                         @relation(fields: [socio_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "suscripciones_ibfk_1")
  planes           planes?                         @relation(fields: [plan_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "suscripciones_ibfk_2")

  @@index([plan_id], map: "plan_id")
  @@index([socio_id], map: "socio_id")
  @@index([tenant_id, fecha_fin], map: "idx_suscripciones_tenant_fin")
}

/// Identidad staff GLOBAL de la plataforma (email único global). El acceso a cada gimnasio se da por `tenant_memberships`.
model usuarios {
  id                     Int                      @id @default(autoincrement())
  nombre                 String?                  @db.VarChar(100)
  email                  String?                  @unique(map: "email") @db.VarChar(100)
  password               String?                  @db.VarChar(255)
  rol                    usuarios_rol?            @default(recepcionista)
  estado                 usuarios_estado?         @default(activo)
  cajas                  cajas[]
  refreshTokens          auth_refresh_tokens[]
  movimientos_inventario movimientos_inventario[]
  tenant_memberships     tenant_memberships[]
}

/// Sesiones (refresh tokens) de staff o socio. GLOBAL en SAAS-03: el tenant se deriva del socio/membership; SAAS-04 decide si se añade `tenant_id`.
model auth_refresh_tokens {
  id           Int       @id @default(autoincrement())
  userId       Int?
  memberId     Int?
  tokenHash    String    @db.VarChar(255)
  jti          String    @unique(map: "jti") @db.VarChar(64)
  expiresAt    DateTime  @db.DateTime(0)
  revokedAt    DateTime? @db.DateTime(0)
  replacedById Int?
  createdAt    DateTime  @default(now()) @db.DateTime(0)
  userAgent    String?   @db.VarChar(255)
  ip           String?   @db.VarChar(64)

  usuarios   usuarios?             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "auth_refresh_tokens_ibfk_1")
  socios     socios?               @relation(fields: [memberId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "auth_refresh_tokens_member_fk")
  replacedBy auth_refresh_tokens?  @relation("refresh_replacement", fields: [replacedById], references: [id], onDelete: SetNull, onUpdate: Restrict)
  replaces   auth_refresh_tokens[] @relation("refresh_replacement")

  @@index([userId], map: "idx_auth_refresh_tokens_userId")
  @@index([memberId], map: "idx_auth_refresh_tokens_memberId")
  @@index([expiresAt], map: "idx_auth_refresh_tokens_expiresAt")
  @@map("auth_refresh_tokens")
}

model ventas {
  id                     Int                      @id @default(autoincrement())
  tenant_id              Int                      @default(dbgenerated())
  caja_id                Int
  /// Relación opcional: la coherencia de tenant con `socios` la valida el trigger.
  socio_id               Int?
  total                  Decimal                  @db.Decimal(10, 2)
  descuento              Decimal                  @default(0.00) @db.Decimal(10, 2)
  metodo_pago            ventas_metodo_pago?      @default(efectivo)
  tipo_comprobante       ventas_tipo_comprobante? @default(boleta)
  cliente_tipo_doc       String?                  @db.VarChar(1)
  fecha                  DateTime?                @default(now()) @db.DateTime(0)
  cliente_num_doc        String?                  @db.VarChar(20)
  cliente_razon          String?                  @db.VarChar(255)
  cliente_direccion      String?                  @db.VarChar(255)
  comprobante_id         Int?
  detalle_ventas         detalle_ventas[]
  movimientos_inventario movimientos_inventario[]
  tenants                tenants                  @relation(fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_ventas_tenant")
  cajas                  cajas                    @relation(fields: [caja_id, tenant_id], references: [id, tenant_id], onUpdate: Restrict, map: "ventas_ibfk_1")
  socios                 socios?                  @relation(fields: [socio_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "ventas_ibfk_2")

  @@unique([id, tenant_id], map: "uq_ventas_id_tenant")
  @@index([caja_id, tenant_id], map: "caja_id")
  @@index([socio_id], map: "socio_id")
  @@index([tenant_id, fecha], map: "idx_ventas_tenant_fecha")
}

