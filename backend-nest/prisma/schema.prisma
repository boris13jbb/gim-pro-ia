/// Conversaciones del asistente IA por socio (Fase 11).
model ai_conversations {
  id             Int                    @id @default(autoincrement())
  tenant_id      Int                    @default(dbgenerated())
  member_id      Int
  titulo         String?                @db.VarChar(120)
  status         ai_conversation_status @default(active)
  creado_en      DateTime               @default(now()) @db.DateTime(0)
  actualizado_en DateTime               @updatedAt @db.DateTime(0)
  tenants        tenants                @relation(fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_ai_conversations_tenant")
  socios         socios                 @relation(fields: [member_id, tenant_id], references: [id, tenant_id], onDelete: Cascade, onUpdate: Restrict, map: "fk_ai_conv_socio")
  ai_messages    ai_messages[]

  @@unique([id, tenant_id], map: "uq_ai_conversations_id_tenant")
  @@index([member_id, tenant_id], map: "idx_ai_conv_member")
  @@index([member_id, status], map: "idx_ai_conv_member_status")
  @@index([tenant_id], map: "idx_ai_conversations_tenant")
}

enum ai_conversation_status {
  active
  archived
}

model ai_messages {
  id               Int              @id @default(autoincrement())
  tenant_id        Int              @default(dbgenerated())
  conversation_id  Int
  role             ai_message_role
  content          String           @db.Text
  metadata         Json?
  creado_en        DateTime         @default(now()) @db.DateTime(0)
  tenants          tenants          @relation(fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_ai_messages_tenant")
  ai_conversations ai_conversations @relation(fields: [conversation_id, tenant_id], references: [id, tenant_id], onDelete: Cascade, onUpdate: Restrict, map: "fk_ai_msg_conv")

  @@index([conversation_id, tenant_id], map: "idx_ai_msg_conv")
  @@index([tenant_id], map: "idx_ai_messages_tenant")
}

enum ai_message_role {
  user
  assistant
  system
}

/// Notificaciones persistidas del socio (Fase 16). Complementan WebSocket `/events`.
model notifications {
  id         Int       @id @default(autoincrement())
  tenant_id  Int       @default(dbgenerated())
  member_id  Int
  type       String    @db.VarChar(60)
  title      String    @db.VarChar(160)
  body       String    @db.VarChar(500)
  data       Json?
  read_at    DateTime? @db.DateTime(0)
  created_at DateTime  @default(now()) @db.DateTime(0)
  updated_at DateTime  @updatedAt @db.DateTime(0)
  tenants    tenants   @relation(fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_notifications_tenant")
  socios     socios    @relation(fields: [member_id, tenant_id], references: [id, tenant_id], onDelete: Cascade, onUpdate: Restrict, map: "fk_notifications_member")

  @@index([member_id, created_at], map: "idx_notifications_member_created")
  @@index([member_id, read_at], map: "idx_notifications_member_read")
  @@index([member_id, tenant_id], map: "idx_notifications_member_tenant")
  @@index([tenant_id], map: "idx_notifications_tenant")
}
