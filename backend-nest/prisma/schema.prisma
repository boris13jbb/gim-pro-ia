generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// Multi-tenancy (SAAS-03):
// Las tablas de negocio llevan `tenant_id` NOT NULL con FK a `tenants`. Las tablas hijas
// referencian a su padre con FK compuesta (padre_id, tenant_id) -> (id, tenant_id), de modo
// que la propia BD rechaza referencias cross-tenant.
// `tenant_id` se declara `@default(dbgenerated())` porque lo resuelve la BD: los triggers
// `trg_*_tenant_bi` lo heredan del padre o, en modo legado (exactamente un tenant), lo asignan
// al único tenant. Así el código actual (single-gym) sigue funcionando hasta SAAS-04/05.
// Ver docs/SAAS-03-MULTI-TENANT-DB.md.

/// Gimnasio (tenant) de la plataforma. `id` es interno (FK); `public_id` (ULID) es el identificador externo.
model tenants {
  id         Int            @id @default(autoincrement())
  public_id  String         @unique(map: "uq_tenants_public_id") @db.Char(26)
  slug       String         @unique(map: "uq_tenants_slug") @db.VarChar(63)
  name       String         @db.VarChar(150)
  status     tenants_status @default(active)
  /// Preparación para entitlements futuros; no hay billing en SAAS-03.
  plan_code  String?        @db.VarChar(40)
  timezone   String         @default("America/Guayaquil") @db.VarChar(64)
  country    String         @default("EC") @db.Char(2)
  metadata   Json?
  created_at DateTime       @default(now()) @db.DateTime(0)
  updated_at DateTime       @default(now()) @updatedAt @db.DateTime(0)

  tenant_memberships        tenant_memberships[]
  asistencias               asistencias[]
  cajas                     cajas[]
  categorias                categorias[]
  comprobantes_detalle      comprobantes_detalle[]
  comprobantes_electronicos comprobantes_electronicos[]
  configuracion             configuracion?
  detalle_ventas            detalle_ventas[]
  gastos                    gastos[]
  medidas                   medidas[]
  planes                    planes[]
  productos                 productos[]
  movimientos_inventario    movimientos_inventario[]
  rutinas                   rutinas[]
  socios                    socios[]
  sri_log                   sri_log[]
  sri_series                sri_series[]
  suscripciones             suscripciones[]
  ventas                    ventas[]
  ai_conversations          ai_conversations[]
  ai_messages               ai_messages[]
  notifications             notifications[]

  @@index([status], map: "idx_tenants_status")
}

enum tenants_status {
  active
  suspended
  cancelled
}

/// Relación staff (usuarios) ↔ gimnasio. Un usuario puede pertenecer a varios tenants.
/// SAAS-03 solo crea la estructura y el backfill; login/JWT/guards no la usan todavía (SAAS-04).
model tenant_memberships {
  id         Int                      @id @default(autoincrement())
  tenant_id  Int
  user_id    Int
  role       tenant_membership_role
  status     tenant_membership_status @default(active)
  created_at DateTime                 @default(now()) @db.DateTime(0)
  updated_at DateTime                 @default(now()) @updatedAt @db.DateTime(0)
  tenants    tenants                  @relation(fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_tenant_memberships_tenant")
  usuarios   usuarios                 @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_tenant_memberships_user")

  @@unique([tenant_id, user_id], map: "uq_tenant_memberships_tenant_user")
  @@index([user_id, status], map: "idx_tenant_memberships_user_status")
}

enum tenant_membership_role {
  owner
  admin
  reception
  trainer
}

enum tenant_membership_status {
  active
  invited
  suspended
  removed
}

model asistencias {
  id              Int                         @id @default(autoincrement())
  tenant_id       Int                         @default(dbgenerated())
  socio_id        Int
  fecha_hora      DateTime?                   @default(now()) @db.DateTime(0)
  metodo_ingreso  asistencias_metodo_ingreso?
  tenants         tenants                     @relation(fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_asistencias_tenant")
  socios          socios                      @relation(fields: [socio_id, tenant_id], references: [id, tenant_id], onDelete: Cascade, onUpdate: Restrict, map: "asistencias_ibfk_1")

  @@index([socio_id, tenant_id], map: "socio_id")
  @@index([tenant_id, fecha_hora], map: "idx_asistencias_tenant_fecha")
}

enum asistencias_metodo_ingreso {
  manual
  dni
  qr
  app
}

model cajas {
  id             Int           @id @default(autoincrement())
  tenant_id      Int           @default(dbgenerated())
  usuario_id     Int
  monto_inicial  Decimal       @db.Decimal(10, 2)
  monto_final    Decimal?      @default(0.00) @db.Decimal(10, 2)
  total_ventas   Decimal?      @default(0.00) @db.Decimal(10, 2)
  total_gastos   Decimal?      @default(0.00) @db.Decimal(10, 2)
  diferencia     Decimal?      @default(0.00) @db.Decimal(10, 2)
  fecha_apertura DateTime?     @default(now()) @db.DateTime(0)
  fecha_cierre   DateTime?     @db.DateTime(0)
  estado         cajas_estado? @default(abierta)
  tenants        tenants       @relation(fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_cajas_tenant")
  usuarios       usuarios      @relation(fields: [usuario_id], references: [id], onUpdate: Restrict, map: "cajas_ibfk_1")
  ventas         ventas[]

  @@unique([id, tenant_id], map: "uq_cajas_id_tenant")
  @@index([usuario_id], map: "usuario_id")
  @@index([tenant_id, estado], map: "idx_cajas_tenant_estado")
}

model categorias {
  id        Int                @id @default(autoincrement())
  tenant_id Int                @default(dbgenerated())
  nombre    String             @db.VarChar(100)
  estado    categorias_estado? @default(activo)
  tenants   tenants            @relation(fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_categorias_tenant")
  productos productos[]

  @@unique([id, tenant_id], map: "uq_categorias_id_tenant")
  @@index([tenant_id], map: "idx_categorias_tenant")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model comprobantes_detalle {
  id                        Int                       @id @default(autoincrement())
  tenant_id                 Int                       @default(dbgenerated())
  comprobante_id            Int
  linea                     Int                       @default(1)
  codigo                    String?                   @db.VarChar(50)
  descripcion               String                    @db.VarChar(255)
  unidad                    String?                   @default("NIU") @db.VarChar(5)
  cantidad                  Decimal                   @default(1.000) @db.Decimal(12, 3)
  valor_unitario            Decimal                   @db.Decimal(12, 4)
  precio_unitario           Decimal                   @db.Decimal(12, 4)
  subtotal                  Decimal                   @db.Decimal(12, 2)
  igv_linea                 Decimal                   @default(0.00) @db.Decimal(12, 2)
  total_linea               Decimal                   @db.Decimal(12, 2)
  tipo_afectacion           String?                   @default("10") @db.VarChar(2)
  tenants                   tenants                   @relation(fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_comprobantes_detalle_tenant")
  comprobantes_electronicos comprobantes_electronicos @relation(fields: [comprobante_id, tenant_id], references: [id, tenant_id], onDelete: Cascade, onUpdate: Restrict, map: "fk_comp_detalle")

  @@index([comprobante_id, tenant_id], map: "idx_comp")
  @@index([tenant_id], map: "idx_comprobantes_detalle_tenant")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model comprobantes_electronicos {
  id                    Int                                     @id @default(autoincrement())
  tenant_id             Int                                     @default(dbgenerated())
  origen_tipo           comprobantes_electronicos_origen_tipo
  origen_id             Int?
  tipo_doc              String                                  @db.VarChar(2)
  serie                 String                                  @db.VarChar(17)
  correlativo           Int
  clave_acceso          String?                                 @db.VarChar(49)
  fecha_emision         DateTime                                @db.Date
  hora_emision          DateTime?                               @db.Time(0)
  fecha_vencimiento     DateTime?                               @db.Date
  emisor_ruc            String                                  @db.VarChar(15)
  emisor_razon          String                                  @db.VarChar(255)
  cliente_tipo_doc      String                                  @db.VarChar(2)
  cliente_num_doc       String?                                 @db.VarChar(20)
  cliente_razon         String                                  @db.VarChar(255)
  cliente_direccion     String?                                 @db.VarChar(255)
  cliente_email         String?                                 @db.VarChar(120)
  moneda                String?                                 @default("PEN") @db.VarChar(3)
  gravadas              Decimal?                                @default(0.00) @db.Decimal(12, 2)
  inafectas             Decimal?                                @default(0.00) @db.Decimal(12, 2)
  exoneradas            Decimal?                                @default(0.00) @db.Decimal(12, 2)
  gratuitas             Decimal?                                @default(0.00) @db.Decimal(12, 2)
  descuentos            Decimal?                                @default(0.00) @db.Decimal(12, 2)
  igv                   Decimal?                                @default(0.00) @db.Decimal(12, 2)
  total                 Decimal                                 @db.Decimal(12, 2)
  total_letras          String?                                 @db.VarChar(255)
  forma_pago            comprobantes_electronicos_forma_pago?   @default(Contado)
  metodo_pago           String?                                 @default("efectivo") @db.VarChar(40)
  ref_tipo_doc          String?                                 @db.VarChar(2)
  ref_serie             String?                                 @db.VarChar(4)
  ref_correlativo       Int?
  motivo_codigo         String?                                 @db.VarChar(2)
  motivo_descripcion    String?                                 @db.VarChar(250)
  xml_firmado           String?                                 @db.MediumText
  sri_authorization_xml String?                                 @db.MediumText
  xml_hash              String?                                 @db.VarChar(64)
  cdr_zip               Bytes?                                  @db.MediumBlob
  cdr_codigo            String?                                 @db.VarChar(10)
  cdr_descripcion       String?                                 @db.VarChar(255)
  estado_sri            comprobantes_electronicos_estado_sri?   @default(pendiente)
  estado_sunat          comprobantes_electronicos_estado_sunat? @default(pendiente)
  mensaje_error         String?                                 @db.Text
  usuario_id            Int?
  creado_en             DateTime?                               @default(now()) @db.DateTime(0)
  actualizado_en        DateTime?                               @default(now()) @db.DateTime(0)
  tenants               tenants                                 @relation(fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_comprobantes_electronicos_tenant")
  comprobantes_detalle  comprobantes_detalle[]

  // Numeración fiscal por emisor: cada gimnasio tiene su propio RUC/serie/secuencial.
  @@unique([tenant_id, tipo_doc, serie, correlativo], map: "unq_comprobante")
  @@unique([id, tenant_id], map: "uq_comprobantes_id_tenant")
  @@index([estado_sunat], map: "idx_estado")
  @@index([fecha_emision], map: "idx_fecha")
  @@index([origen_tipo, origen_id], map: "idx_origen")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
