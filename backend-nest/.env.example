PORT=3000
NODE_ENV=development

# Base de datos (MySQL/MariaDB) — misma BD que PHP legacy en fases iniciales
DATABASE_URL="mysql://root:@127.0.0.1:3306/ec_gym_system"

# JWT (Fase 02) — en producción usar secretos únicos de 32+ caracteres
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Rate limit (evita bloqueos en auditoría: subir THROTTLE_LOGIN_LIMIT en dev)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
THROTTLE_LOGIN_TTL_MS=60000
THROTTLE_LOGIN_LIMIT=30

# CORS — incluir puerto de Flutter web en dev (ej. :8080)
CORS_ORIGINS="http://localhost:3000,http://localhost:8080,http://127.0.0.1:8080"

# Swagger
SWAGGER_ENABLED=true

# Uploads (fotos de socios y productos)
UPLOADS_DIR=uploads/members
PRODUCT_UPLOADS_DIR=uploads/products
MAX_PHOTO_SIZE_MB=5

# SRI Ecuador (Fase 09) — certificado relativo a public/{SRI_CERT_DIR}/
SRI_CERT_DIR=cert
SRI_XML_DIR=sri/xml

# SMTP — envío de comprobantes al cliente (RIDE PDF + XML)
# Gmail: usar contraseña de aplicación (no la contraseña de la cuenta)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=contraseña_de_aplicacion
SMTP_FROM=tu-correo@gmail.com

# IA (Fase 11) — solo en servidor; nunca en Flutter
# Proveedor: ollama (local + voz) | gemini | zai
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
GEMINI_API_KEY=change_me_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash
ZAI_API_KEY=change_me_zai_api_key
ZAI_MODEL=glm-5.2
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
AI_DAILY_MESSAGE_LIMIT=50
AI_INTENT_ENABLED=false
AI_MAX_HISTORY_MESSAGES=12
AI_THROTTLE_LIMIT=20
AI_THROTTLE_TTL_MS=60000

# Pipeline de voz: Mic → faster-whisper → Ollama → Piper → altavoz
VOICE_PIPELINE_ENABLED=true
FASTER_WHISPER_MODEL=base
WHISPER_LANGUAGE=es
PYTHON_EXECUTABLE=python
VOICE_TRANSCRIBE_SCRIPT=../scripts/voice/transcribe.py
PIPER_EXECUTABLE=piper
PIPER_MODEL_PATH=C:/ruta/models/es_ES-sharvard-medium.onnx
PIPER_CONFIG_PATH=C:/ruta/models/es_ES-sharvard-medium.onnx.json
VOICE_MAX_AUDIO_MB=10
VOICE_STT_TIMEOUT_MS=120000
VOICE_TTS_TIMEOUT_MS=60000

# Alertas proactivas de membresía por vencer (Fase 17)
MEMBERSHIP_ALERTS_ENABLED=true
MEMBERSHIP_ALERTS_CRON=0 8 * * *
MEMBERSHIP_ALERT_DAYS=7,3,1,0
